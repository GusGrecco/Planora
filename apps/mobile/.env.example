# Planora Mobile — Environment Variables
# Copy this file to `.env` and adjust values for your local environment.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the client bundle.
# Never place secrets here — mobile env vars are not secure storage.

# Base URL of the Planora API for local development.
# Use your machine's LAN IP instead of localhost when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000